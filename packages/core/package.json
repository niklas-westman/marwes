{
  "name": "@marwes-ui/core",
  "version": "1.6.1",
  "description": "Framework-agnostic Marwes UI contracts, theme primitives, accessibility helpers, and component recipes.",
  "homepage": "https://marwes.io/docs/contributing/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niklas-westman/marwes.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/niklas-westman/marwes/issues"
  },
  "keywords": ["marwes", "design-system", "typescript", "accessibility", "ui"],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsup --watch",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "NODE_ENV=test vitest run",
    "clean": "rimraf dist",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "generate:icons": "tsx scripts/generate-icon-names.ts"
  },
  "devDependencies": {
    "rimraf": "6.1.2",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
