{
  "name": "@marwes-ui/vue",
  "version": "1.6.0",
  "description": "Accessible, themeable Marwes components for Vue with static preset CSS and purpose-first APIs.",
  "homepage": "https://marwes.io/docs/get-started/vue/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niklas-westman/marwes.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/niklas-westman/marwes/issues"
  },
  "keywords": ["marwes", "vue", "components", "design-system", "accessibility"],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "default": "./dist/ssr.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "NODE_ENV=test vitest run",
    "clean": "rimraf dist",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@marwes-ui/core": "workspace:*",
    "@marwes-ui/presets": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "devDependencies": {
    "@testing-library/vue": "8.1.0",
    "rimraf": "6.1.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vue": "3.5.28"
  }
}
